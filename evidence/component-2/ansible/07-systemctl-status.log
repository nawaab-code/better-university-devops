# Ansible managed
[Unit]
Description=Better University Campus API 1.1.0
After=network.target

[Service]
Type=simple
User=bu-campus
Group=bu-campus
WorkingDirectory=/opt/bu-campus-api
EnvironmentFile=/etc/default/bu-campus-api
ExecStart=/usr/bin/java -jar /opt/bu-campus-api/bu-campus-api.jar
Restart=on-failure
RestartSec=3
# Light hardening
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target

